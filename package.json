{
  "name": "chartjs-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "doDev": "vite",
    "doBuild": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings a11y-click-events-have-key-events:ignore",
    "watch:check": "svelte-check --tsconfig ./tsconfig.json --watch --compiler-warnings a11y-click-events-have-key-events:ignore",
    "dev": "run-p watch:check doDev",
    "build": "run-s check doBuild",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@tsconfig/svelte": "5.0.5",
    "gh-pages": "6.3.0",
    "npm-run-all2": "8.0.4",
    "svelte-check": "4.3.2",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "dependencies": {
    "carbon-components-svelte": "0.89.7",
    "chart.js": "4.5.0",
    "svelte": "5.39.4",
    "svelte-jsoneditor": "3.9.0",
    "svelte-splitpanes": "8.0.9"
  }
}
