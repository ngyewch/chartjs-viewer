{
  "name": "chartjs-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "doDev": "vite",
    "doBuild": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "watch:check": "svelte-check --tsconfig ./tsconfig.app.json --watch --compiler-warnings a11y-click-events-have-key-events:ignore",
    "dev": "run-p watch:check doDev",
    "build": "run-s check doBuild",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.12.4",
    "gh-pages": "6.3.0",
    "npm-run-all2": "9.0.1",
    "svelte-check": "4.5.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "dependencies": {
    "carbon-components-svelte": "0.107.1",
    "chart.js": "4.5.1",
    "svelte": "5.56.1",
    "svelte-jsoneditor": "3.12.0",
    "svelte-splitpanes": "8.0.9"
  }
}
